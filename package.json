{
  "name": "z-widgets",
  "version": "0.1.1",
  "description": "Cross-platform desktop widget application",
  "main": "./out/main/index.js",
  "author": {
    "name": "Zeesu Royalist",
    "email": "rzeesu@gmail.com",
    "url": "https://zeesu-royalist.vercel.app"
  },
  "homepage": "https://zeesu-royalist.vercel.app",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "npm run test:m4",
    "test:m4": "esbuild scripts/verify-milestone4.ts --bundle --platform=node --external:electron --outfile=out/main/verify-m4.js && env -u ELECTRON_RUN_AS_NODE electron out/main/verify-m4.js",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:intel": "npm run build && electron-builder --mac --x64",
    "build:mac:arm": "npm run build && electron-builder --mac --arm64",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:linux": "npm run build && electron-builder --linux --x64",
    "build:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "lucide-react": "^1.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^6.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.zwidgets.app",
    "productName": "Z-Widgets",
    "electronLanguages": [
      "en",
      "en-US",
      "en-GB"
    ],
    "compression": "maximum",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableArgs": [
        "--no-sandbox"
      ],
      "category": "Utility",
      "desktop": {
        "StartupWMClass": "z-widgets"
      }
    }
  }
}
